# Copy this file to backend/.env and fill in the values you need.
# Every setting is optional: without a Groq key the scanner, scoring and
# remediation still work; AI explanations, chat and adaptive AI
# interpretation are disabled.

# Groq API keys. Keys are tried in this order: GROQ_API_KEY, then _1 .. _4.
# The next key is used when one is rate-limited (429) or rejected (401/403/404).
# Keys from the same Groq organization share one daily quota.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=

# SQLite database for administrator-confirmed adaptive mappings.
# Default: backend/data/adaptive.db. A relative path is resolved from the
# directory uvicorn is started in.
# ADAPTIVE_DB_PATH=data/adaptive.db

# Legacy: send lines the Cisco/FortiGate parsers do not read to the line interpreter (default: false).
# Its interpretations only reach the review queue.
# ADAPTIVE_AI_FOR_KNOWN_VENDORS=false

# AI judge requests per scan for unknown-vendor configs (default: 2; cache hits are free).
# AI_JUDGE_MAX_CALLS_PER_SCAN=2

# Share of meaningful lines that must follow the detected vendor's grammar before its parser is trusted (default: 0.7).
# VENDOR_PARSE_COVERAGE_THRESHOLD=0.7
